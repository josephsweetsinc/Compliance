# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# RESEND_API_KEY: Required for sending email notifications via Resend.
RESEND_API_KEY=
# RESEND_FROM_EMAIL: The verified sender email address for Resend (e.g., reports@yourdomain.com). Defaults to onboarding@resend.dev if omitted.
RESEND_FROM_EMAIL=

# INTERNAL_API_KEY: Secret key required for authorizing internal API endpoints (/api/*).
INTERNAL_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# TWILIO_ACCOUNT_SID: Required for sending SMS notifications via Twilio.
TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN: Required for sending SMS notifications via Twilio.
TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER: The virtual phone number purchased from Twilio (in E.164 format, e.g., +15017122661) used as the "From" number for SMS notifications.
TWILIO_PHONE_NUMBER=

# VITE_GA_TRACKING_ID: Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_TRACKING_ID=
