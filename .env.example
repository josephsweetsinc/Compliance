# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# STRIPE_SECRET_KEY: Stripe Secret Key for processing payments (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=

# STRIPE_PUBLISHABLE_KEY: Stripe Publishable Key (pk_test_... or pk_live_...)
STRIPE_PUBLISHABLE_KEY=

# STRIPE_WEBHOOK_SECRET: Signing secret for Stripe webhooks (whsec_... from Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=

# RESEND_API_KEY: Optional - For sending compliance report emails via Resend
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Sender email address (e.g. reports@reports.complyzzz.com)
RESEND_FROM_EMAIL=reports@reports.complyzzz.com

# TWILIO_ACCOUNT_SID: Optional - For sending SMS alerts via Twilio
TWILIO_ACCOUNT_SID=

# TWILIO_AUTH_TOKEN: Optional - For sending SMS alerts via Twilio
TWILIO_AUTH_TOKEN=

# TWILIO_PHONE_NUMBER: Optional - Twilio phone number
TWILIO_PHONE_NUMBER=

# VITE_GA_TRACKING_ID: Optional - Google Analytics 4 Measurement ID for marketing traffic tracking (e.g. G-XXXXXXXXXX)
VITE_GA_TRACKING_ID=

