rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (uid)
    // Fields:
    //   - uid: string (required, immutable)
    //   - email: string (required, immutable)
    //   - displayName: string (optional)
    //   - clinicName: string (required)
    //   - createdAt: string (required, immutable)
    //
    // Collection: reports
    // Document ID: reportId
    // Fields:
    //   - id: string (required, immutable)
    //   - clinicId: string (required, immutable, matches current user uid)
    //   - patientName: string (required)
    //   - dob: string (optional)
    //   - licenseNumber: string (optional)
    //   - licenseState: string (optional)
    //   - metrics: map (required)
    //   - status: string (required, enum: ['Compliant', 'Non-Compliant'])
    //   - createdAt: string (required, immutable)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.clinicId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'clinicName', 'createdAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() > 0 &&
             data.clinicName is string && data.clinicName.size() > 0 && data.clinicName.size() < 100 &&
             data.createdAt is string;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['id', 'clinicId', 'patientName', 'metrics', 'status', 'createdAt']) &&
             data.id is string &&
             data.clinicId is string && data.clinicId == request.auth.uid &&
             data.patientName is string && data.patientName.size() > 0 && data.patientName.size() < 100 &&
             (!('dob' in data) || (data.dob is string && data.dob.size() <= 20)) &&
             (!('licenseNumber' in data) || (data.licenseNumber is string && data.licenseNumber.size() <= 50)) &&
             (!('licenseState' in data) || (data.licenseState is string && data.licenseState.size() <= 20)) &&
             data.metrics is map &&
             data.status in ['Compliant', 'Non-Compliant'] &&
             data.createdAt is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.email == resource.data.email &&
                      request.resource.data.createdAt == resource.data.createdAt;
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.clinicId == request.auth.uid);
      allow create: if isAuthenticated() && isValidReport(request.resource.data);
      allow update: if isDocOwner() && isValidReport(request.resource.data) &&
                      request.resource.data.id == resource.data.id &&
                      request.resource.data.clinicId == resource.data.clinicId &&
                      request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isDocOwner();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
