rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.clinicId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'clinicName', 'createdAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.clinicName is string && data.clinicName.size() > 0 && data.clinicName.size() <= 200 &&
             data.createdAt is string &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200)) &&
             (!('autoEmailEnabled' in data) || data.autoEmailEnabled is bool) &&
             (!('subscriptionPlan' in data) || (data.subscriptionPlan is string && data.subscriptionPlan in ['free', 'per_report', 'monthly_clinic'])) &&
             (!('subscriptionStatus' in data) || (data.subscriptionStatus is string && data.subscriptionStatus in ['active', 'inactive', 'trial', 'canceled'])) &&
             (!('subscriptionCurrentPeriodEnd' in data) || (data.subscriptionCurrentPeriodEnd is string && data.subscriptionCurrentPeriodEnd.size() <= 100)) &&
             (!('reportCredits' in data) || (data.reportCredits is number && data.reportCredits >= 0)) &&
             (!('stripeCustomerId' in data) || (data.stripeCustomerId is string && data.stripeCustomerId.size() <= 256)) &&
             (!('stripeSubscriptionId' in data) || (data.stripeSubscriptionId is string && data.stripeSubscriptionId.size() <= 256));
    }

    // Billing/entitlement fields: subscription plans and Stripe IDs cannot be modified
    // by the client. reportCredits can either remain unchanged or be decremented
    // (consumed) when processing compliance reports. It can never be increased by the client.
    function billingFieldsAllowed() {
      let before = existing();
      let after = incoming();
      let planUnchanged = after.get('subscriptionPlan', 'free') == before.get('subscriptionPlan', 'free') &&
                          after.get('subscriptionStatus', 'inactive') == before.get('subscriptionStatus', 'inactive') &&
                          after.get('subscriptionCurrentPeriodEnd', null) == before.get('subscriptionCurrentPeriodEnd', null) &&
                          after.get('stripeCustomerId', null) == before.get('stripeCustomerId', null) &&
                          after.get('stripeSubscriptionId', null) == before.get('stripeSubscriptionId', null);
      // reportCredits can be decremented on report processing or refunded/restored when an error occurs
      let creditsValid = after.get('reportCredits', 0) is number &&
                         after.get('reportCredits', 0) >= 0 &&
                         after.get('reportCredits', 0) <= 500;
      return planUnchanged && creditsValid;
    }

    // On initial profile creation, only the default trial state may be set -
    // never an arbitrary paid plan or credit balance.
    function billingFieldsAreDefaults(data) {
      return data.get('subscriptionPlan', 'free') == 'free' &&
             data.get('subscriptionStatus', 'trial') == 'trial' &&
             !('subscriptionCurrentPeriodEnd' in data) &&
             data.get('reportCredits', 0) <= 1 &&
             !('stripeCustomerId' in data) &&
             !('stripeSubscriptionId' in data);
    }

    function isValidReport(data) {
      return data.keys().hasAll(['id', 'clinicId', 'patientName', 'metrics', 'status', 'createdAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.clinicId is string && data.clinicId == request.auth.uid &&
             data.patientName is string && data.patientName.size() >= 0 && data.patientName.size() <= 200 &&
             (!('dob' in data) || (data.dob is string && data.dob.size() <= 100)) &&
             (!('licenseNumber' in data) || (data.licenseNumber is string && data.licenseNumber.size() <= 100)) &&
             (!('licenseState' in data) || (data.licenseState is string && data.licenseState.size() <= 100)) &&
              data.metrics is map &&
             data.status in ['Compliant', 'Non-Compliant'] &&
             data.createdAt is string;
    }

    function isValidErrorLog(data) {
      return data.keys().hasAll(['id', 'errorType', 'message', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.errorType is string && data.errorType in ['API_FAILURE', 'RENDER_ERROR', 'NETWORK_ERROR', 'FIREBASE_ERROR', 'AUTH_ERROR', 'UNHANDLED_REJECTION'] &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.createdAt is string &&
             (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128)) &&
             (!('userEmail' in data) || data.userEmail == null || (data.userEmail is string && data.userEmail.size() <= 256)) &&
             (!('apiEndpoint' in data) || data.apiEndpoint == null || (data.apiEndpoint is string && data.apiEndpoint.size() <= 500)) &&
             (!('status' in data) || data.status == null || data.status is number) &&
             (!('errorName' in data) || data.errorName == null || (data.errorName is string && data.errorName.size() <= 128)) &&
             (!('stack' in data) || data.stack == null || (data.stack is string && data.stack.size() <= 5000)) &&
             (!('url' in data) || data.url == null || (data.url is string && data.url.size() <= 500)) &&
             (!('userAgent' in data) || data.userAgent == null || (data.userAgent is string && data.userAgent.size() <= 500)) &&
             (!('context' in data) || data.context == null || data.context is map);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && billingFieldsAreDefaults(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       billingFieldsAllowed();
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.clinicId == request.auth.uid);
      allow create: if isAuthenticated() && isValidId(reportId) && isValidReport(incoming()) && incoming().id == reportId;
      allow update: if isDocOwner() && isValidId(reportId) && isValidReport(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().clinicId == existing().clinicId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isDocOwner();
    }

    match /error_logs/{logId} {
      // Diagnostic error logs can be submitted by clients encountering errors.
      // If signed in, verify userId matches caller or is null to prevent spoofing.
      allow create: if isValidId(logId) && isValidErrorLog(incoming()) && incoming().id == logId &&
                       (!isAuthenticated() || incoming().get('userId', null) == null || incoming().userId == request.auth.uid);
      // Users can inspect their own session error logs
      allow read: if isAuthenticated() && (resource == null || resource.data.get('userId', null) == request.auth.uid);
      // Immutable audit records
      allow update, delete: if false;
    }
  }
}
