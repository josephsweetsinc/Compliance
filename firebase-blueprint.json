{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores clinical staff profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID from Firebase Auth." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's full name." },
        "clinicName": { "type": "string", "description": "Name of the occupational health clinic." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the profile was created." },
        "autoEmailEnabled": { "type": "boolean", "description": "Whether to auto email report summaries." },
        "subscriptionPlan": { "type": "string", "enum": ["free", "per_report", "monthly_clinic"], "description": "Active pricing tier." },
        "subscriptionStatus": { "type": "string", "enum": ["active", "inactive", "trial", "canceled"], "description": "Status of the subscription." },
        "subscriptionCurrentPeriodEnd": { "type": "string", "description": "Subscription end date." },
        "reportCredits": { "type": "number", "description": "Number of available report generation credits." },
        "stripeCustomerId": { "type": "string", "description": "Associated Stripe customer ID." },
        "stripeSubscriptionId": { "type": "string", "description": "Associated Stripe subscription ID." }
      },
      "required": ["uid", "email", "clinicName", "createdAt"]
    },
    "ComplianceReport": {
      "title": "Compliance Report",
      "description": "Stores extracted CPAP compliance metrics and status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique report ID." },
        "clinicId": { "type": "string", "description": "ID of the clinic that uploaded the report." },
        "patientName": { "type": "string", "description": "Extracted patient name." },
        "dob": { "type": "string", "description": "Patient's date of birth." },
        "licenseNumber": { "type": "string", "description": "Patient's driver license number." },
        "licenseState": { "type": "string", "description": "State of issuance for the driver license." },
        "metrics": {
          "type": "object",
          "properties": {
            "patient_name": { "type": "string" },
            "start_date": { "type": "string" },
            "end_date": { "type": "string" },
            "total_nights": { "type": "number" },
            "nights_over_4_hours": { "type": "number" },
            "compliance_percentage": { "type": "number" },
            "average_usage_hours": { "type": "number" },
            "ahi": { "type": "number" }
          }
        },
        "status": { "type": "string", "enum": ["Compliant", "Non-Compliant"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "When the report data will be deleted from the system." }
      },
      "required": ["id", "clinicId", "patientName", "metrics", "status", "createdAt", "expiresAt"]
    },
    "ErrorLog": {
      "title": "Error Log",
      "description": "Stores diagnostic logs for caught rendering and API failures to identify root causes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique error log ID." },
        "errorType": {
          "type": "string",
          "enum": ["API_FAILURE", "RENDER_ERROR", "NETWORK_ERROR", "FIREBASE_ERROR", "AUTH_ERROR", "UNHANDLED_REJECTION"],
          "description": "Classification of the error."
        },
        "message": { "type": "string", "description": "Human-readable error description." },
        "apiEndpoint": { "type": "string", "description": "HTTP endpoint URL if this was an API-specific failure." },
        "status": { "type": "number", "description": "HTTP status code or application error code." },
        "errorName": { "type": "string", "description": "Class or name of the error exception." },
        "stack": { "type": "string", "description": "Sanitized stack trace." },
        "userId": { "type": "string", "description": "User UID associated with the session, if authenticated." },
        "userEmail": { "type": "string", "description": "User email address, if available." },
        "url": { "type": "string", "description": "Route pathname or URL where the error occurred." },
        "userAgent": { "type": "string", "description": "Browser user agent for device diagnosis." },
        "context": { "type": "object", "description": "Sanitized operational context metadata." },
        "createdAt": { "type": "string", "format": "date-time", "description": "ISO timestamp when the error occurred." }
      },
      "required": ["id", "errorType", "message", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document."
    },
    "/reports/{reportId}": {
      "schema": "ComplianceReport",
      "description": "Individual CPAP compliance report."
    },
    "/error_logs/{logId}": {
      "schema": "ErrorLog",
      "description": "Collection of caught API, network, and rendering failure logs."
    }
  }
}
